{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "backend/src",
    "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "backend/tsconfig.build.json",
        "assets": [
            {
                "include": "migrations/patches/**/*.json",
                "watchAssets": true
            }
        ]
    }
}