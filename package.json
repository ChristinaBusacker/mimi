{
  "name": "mimi",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others-on-fail \"npm:frontend:start\" \"npm:backend:start\"",
    "build": "npm run frontend:build && npm run backend:build",
    "frontend:start": "ng serve frontend",
    "frontend:build": "ng build frontend",
    "frontend:test": "ng test frontend",
    "frontend:serve:ssr": "node dist/frontend/server/server.mjs",
    "backend:start": "nest start --watch",
    "backend:build": "nest build",
    "backend:start:prod": "node dist/backend/main.js"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "express": "^5.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}